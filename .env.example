PORT=3101
branch=
DATABASE_URL=postgres://greact:pG3526l4@194.36.208.86:5433/cloud

# Optional. When set, POST /api/ingest requires x-api-key: <value>.
INGEST_API_KEY=

# Poll interval for GET /api/current/events SSE snapshots.
CURRENT_EVENTS_POLL_MS=1000

# Optional for local development. When set, UI API routes require Keycloak Bearer tokens.
KEYCLOAK_ISSUER_URL=https://sso.greact.ru/realms/toir
KEYCLOAK_CLIENT_ID=greact-drill-ui

# Realm/client roles with this prefix grant access to matching edge ids.
# Example: role "drill-edge-demo" grants access to edge "demo".
KEYCLOAK_EDGE_ROLE_PREFIX=drill-edge-

# Users with one of these realm/client roles can access all edges.
KEYCLOAK_ADMIN_ROLES=drill-admin,admin
